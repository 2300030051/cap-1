{
  "name": "credential-project",
  "version": "1.0.0",
  "description": "Secure Academic Credential Verification Project",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "blockchain:node": "npx hardhat node --config blockchain/hardhat.config.js",
    "blockchain:compile": "npx hardhat compile --config blockchain/hardhat.config.js",
    "blockchain:deploy": "npx hardhat run blockchain/scripts/deploy.js --config blockchain/hardhat.config.js --network localhost",
    "blockchain:test": "npx hardhat test --config blockchain/hardhat.config.js",
    "test": "npm run blockchain:test && node --test tests/*.test.js"
  },
