    "dotenv": "^16.4.7",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "hardhat": "^2.22.17",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
